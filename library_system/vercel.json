{
  "version": 2,
  "builds": [
    {
      "src": "library_system/library_system/wsgi.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/static/(.*)",
      "dest": "/library_system/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "library_system/library_system/wsgi.py"
    }
  ]
}
